{# Under the PayPlug method of the payment step, once chosen. In lightbox mode the root
   carries the address the order button leads to: lightbox-script.html.twig opens the
   PayPlug form instead of following it. The texts come translated from
   PayPlugPaymentThemeHook; the classes are those of the Flexy theme. #}
<div class="PayPlugPaymentExtra"{% if payUrl %} data-payplug-lightbox data-pay-url="{{ payUrl }}"{% endif %}>
    {% if savedCard %}
        <p class="mt-4"><strong>{{ savedCard.title }}</strong></p>
        <p class="paragraph-4 mt-1">
            {{ savedCard.notice }}
            <button type="submit" class="underline" form="payplug-delete-card">{{ savedCard.deleteLabel }}</button>
        </p>
        <form id="payplug-delete-card" method="post" action="{{ savedCard.deleteUrl }}">
            <input type="hidden" name="_token" value="{{ csrf_token('payplug_card_delete') }}">
        </form>
    {% endif %}
</div>
